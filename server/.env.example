# SysaiQ server config — copy to .env on the server and fill in.
NODE_ENV=production
PORT=3000

# admin bootstrap (created on first run if no admin exists)
ADMIN_USER=admin
ADMIN_PASS=change-this-now

# session signing secret (any long random string)
JWT_SECRET=change-this-to-a-long-random-string

# AI assistant (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# outbound mail for lead notifications (optional until email is set up)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SysaiQ <hello@sysaiq.com>
LEAD_NOTIFY_TO=hello@sysaiq.com

# paths (leave as-is for standard deploy)
SITE_DIR=/var/www/sysaiq/site
