# SysaiQ server config — copy to .env on the server and fill in.
# In production the app refuses to start when JWT_SECRET or SECRETS_KEY is
# missing/weak, or when no admin exists yet and ADMIN_PASS is missing/weak.
NODE_ENV=production
PORT=3000

# admin bootstrap (used only on the first run, while no admin exists)
ADMIN_USER=admin
ADMIN_PASS=change-this-now

# session signing secret — at least 24 random characters:  openssl rand -hex 32
JWT_SECRET=change-this-to-a-long-random-string

# encryption key for the secrets table (AES-256-GCM) — exactly 32 random bytes
# as base64 or hex. Generate it once with:
#   openssl rand -base64 32
# Every API key saved from the admin panel (OpenAI, gateways, SMS) is encrypted
# with it; losing or changing it makes them unreadable, so back it up with the
# database. Migration 002 moves the old plaintext OpenAI key here on first boot.
SECRETS_KEY=

# canonical public origin — used for redirects and the admin CSRF origin check
# (never the Host header). Extra origins the admin may be opened from,
# comma-separated, go in ALLOWED_ORIGINS.
PUBLIC_BASE_URL=https://sysaiq.com
ALLOWED_ORIGINS=https://www.sysaiq.com

# AI assistant (OpenAI) — fallback only; the key saved from the admin panel
# (encrypted in the secrets table) takes precedence. Model can be set there too.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# contact-form submissions accepted per visitor ip per hour (default 15)
# LEADS_RATE_MAX=15

# outbound mail for lead notifications (optional until email is set up)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SysaiQ <hello@sysaiq.com>
LEAD_NOTIFY_TO=hello@sysaiq.com

# paths (leave as-is for standard deploy)
SITE_DIR=/var/www/sysaiq/site
# DATA_DIR   — where sysaiq.db lives (default: ./data next to package.json).
#              Must be writable by the service user and included in backups.
# UPLOAD_DIR — where admin image uploads are stored and served from /uploads
#              (default: $DATA_DIR/uploads). Only JPEG/PNG/WebP/GIF are accepted.
# DATA_DIR=/var/www/sysaiq/app/data
# UPLOAD_DIR=/var/www/sysaiq/app/data/uploads
